{
  "name": "todo-v4-week11-react",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src/ --ext .ts,.tsx",
    "format": "prettier --write src tests/core.test.ts index.html style.css package.json tsconfig.json vite.config.ts .eslintrc.cjs",
    "format:check": "prettier --check src tests/core.test.ts index.html style.css package.json tsconfig.json vite.config.ts .eslintrc.cjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.46.0",
    "@typescript-eslint/parser": "8.46.0",
    "eslint": "8.57.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "@vitejs/plugin-react": "5.1.0",
    "vite": "7.3.7",
    "vitest": "3.2.4"
  }
}
